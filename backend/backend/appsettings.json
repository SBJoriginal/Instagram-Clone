{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "UGramApi",
    "Audience": "UGramClients",
    "ExpirationMinutes": 60
  },
  "FileUpload": {
    "AllowedImageExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".webp",
      ".avif"
    ],
    "MaxFileSizeInMB": 5,
    "ImageMimeTypes": {
      ".avif": "image/avif",
      ".webp": "image/webp"
    }
  },
  "AWS": {
    "Profile": "default",
    "Region": "us-east-1"
  },
  "S3": {
    "BucketName": "ugram-images-bucket",
    "PresignedUrlExpirationMinutes": 60
  }
}