{
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=ugram_dev;Username=postgres;Password=${DB_PASSWORD}"
    },
    
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
    "JwtSettings": {
        "Secret": "${JWT_SECRET}",
        "Issuer": "UGramApi",
        "Audience": "UGramClients",
        "ExpirationMinutes": 60
    }
}