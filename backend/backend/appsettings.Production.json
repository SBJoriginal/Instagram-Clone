{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "JwtSettings": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "UGramApi",
    "Audience": "UGramClients",
    "ExpirationMinutes": 60
  },
  "AWS": {
    "Region": "us-east-1",
    "S3": {
      "BucketName": "${AWS_S3_BUCKET_NAME}"
    }
  }
}
