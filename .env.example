# Copy this file to .env and fill in values. NEVER commit .env

# --- Local Docker (required for: docker compose up) ---
DB_PASSWORD=
JWT_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET_NAME=

# --- Staging override (required for: docker compose -f docker-compose.yml -f docker-compose.staging.yml up) ---
# Format: Host=<rds-endpoint>;Database=ugram_staging;Username=postgres;Password=<password>
STAGING_DB_CONNECTION=
# --- Google Auth ---
GOOGLE_CLIENT_ID=

# --- Sentry ---
SENTRY_DSN=
